# Copy to .env and fill in what you have. Every key is optional:
# an app with no key for a service runs that part in mock mode.
# Add each new key here (empty) when an app starts reading it, with the app that uses it.

# apps/muse-avatar: read by the gadget bridge (muse-avatar run) on the Pi, all optional.
# The bridge key normally lives in /var/lib/musegadget/avatar_key (root-only), like the SDK token.
MUSE_AVATAR_KEY=
MUSE_AVATAR_PORT=
MUSE_AVATAR_HOST=
MUSE_AVATAR_NAME=
MUSE_AVATAR_PAGE=
